{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MelliLex",
  "version": "0.11.0",
  "identifier": "com.rahultr.mellilex",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MelliLex",
        "minWidth": 800,
        "minHeight": 750,
        "width": 800,
        "height": 750,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "windowEffects": {
          "effects": [
            "mica"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Rahul TR",
    "windows": {},
    "resources": [
      "WebView2Loader.dll",
      "resources/dictionaries/*",
      "resources/tesseract/*.exe",
      "resources/tesseract/*.dll",
      "resources/tesseract/tessdata/*.traineddata"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/trrahul/MelliLex/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0QTZDODAzMUREMTdGNzkKUldSNWY5RWRBOGltTkRCeGtIb2lyeFA1QXp1MzJhSUpoREMrWGJqSmwxbVoxd2tPckNHOWtzUTYK"
    }
  }
}
